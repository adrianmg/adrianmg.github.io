---
// Square icon buttons that shuffle every control or put them all back.
// Place it anywhere inside a <Playground>; it works on that playground's form.
---

<div class="playground-actions">
  <button type="button" data-playground-randomize aria-label="Randomize settings" title="Randomize">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M1.75 4.5h2.5c1.6 0 2.6.8 3.6 2.2l1.3 2.1c.9 1.4 1.9 2.2 3.5 2.2h1.6M1.75 11h2.5c1.2 0 2-.4 2.7-1.2M9.4 5.7c.7-.8 1.5-1.2 2.7-1.2h1.6M12 2.5l2 2-2 2M12 9l2 2-2 2"/></svg>
  </button>
  <button type="reset" aria-label="Reset settings" title="Reset">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M2.5 3v3.25h3.25M2.9 6A5.5 5.5 0 1 1 2.75 10"/></svg>
  </button>
</div>
