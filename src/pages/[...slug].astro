---
import { getCollection, render } from "astro:content";
import { renderSummary } from "../lib/markdown.mjs";

import BaseLayout from "../layouts/BaseLayout.astro";
import PostLayout from "../layouts/PostLayout.astro";
import {
  formatXmlDate,
  postDescription,
  postPath,
  postSocialImage,
  type PostEntry,
} from "../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: postPath(post).slice(1, -1) },
    props: { post },
  }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const description = postDescription(post.body ?? "");
const summaryHtml = post.data.summary
  ? await renderSummary(post.data.summary)
  : undefined;
---

<BaseLayout
  pageTitle={post.data.title}
  description={description}
  canonicalPath={postPath(post)}
  image={postSocialImage(post)}
  kind="post"
  publishedTime={formatXmlDate(post.data.date)}
>
  <PostLayout
    title={post.data.title}
    date={post.data.date}
    summaryHtml={summaryHtml}
  >
    <Content />
  </PostLayout>
</BaseLayout>
